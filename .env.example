# Nomad runs on NEAR testnet only. Copy to .env and fill in what you need; never commit real keys.
# Every value below is optional: the default is shown, and an empty value means "unset".

# ---- network and accounts (apps/matcher config, packages/colo) ----
# Network for the colo CLI: testnet (default) or mainnet.
NEAR_NETWORK=testnet
# NEAR RPC endpoint used by the matcher and the colo CLI.
RPC_URL=https://test.rpc.fastnear.com
# Extra RPC endpoints to rotate to on 429/5xx or network errors, comma-separated (packages/intents).
NEAR_RPC_FALLBACKS=
# RPC endpoint for scripts/deploy-board.mjs and scripts/hos-budget.ts.
NEAR_RPC=https://test.rpc.fastnear.com
# Our own deployment of the near/intents Verifier on testnet (intents.near does not exist on testnet).
VERIFIER_ID=intents.nomadswarm.testnet
# Parent account that owns the agent, matcher and contract sub-accounts.
PARENT_ACCOUNT=nomadswarm.testnet
# Parent account for scripts/hos-budget.ts.
PARENT=nomadswarm.testnet
# The offer board contract.
BOARD_ID=board.nomadswarm.testnet
# The matcher account that signs execute_intents.
MATCHER_ID=intents-matcher.nomadswarm.testnet
# A second matcher used as the control in race runs.
CONTROL_MATCHER_ID=
# The mandate contract (scripts/mandate-*.ts). Default: mandate.<PARENT>.
MANDATE_ID=
# Directory with the agents' key files (gitignored).
KEYS_DIR=./keys
# Where NEAR CLI credentials live. Default: ~/.near-credentials/<network>.
NEAR_CREDENTIALS_DIR=
# Config file for the agent CLI and MCP server.
NOMAD_CONFIG=config/testnet.json
# Agent account name prefix: a01, a02, ... (fx for fixture agents).
AGENT_PREFIX=a

# ---- agent (apps/agent CLI) ----
# The agent's account id (required by the agent CLI).
AGENT=
# Strategy: spender, rebalancer, collector, random or llm.
STRATEGY=spender
# Token the agent wants, e.g. nep141:usdc.nomadswarm.testnet.
TARGET=
# Price margin the agent builds into its limit rate, as a fraction.
MARGIN=0.008
# Matcher WebSocket the agent connects to.
MATCHER_WS=ws://localhost:8787/ws
# 1 lets NEAR AI Cloud set the margin (needs NEARAI_API_KEY).
LLM=0
# NEAR AI Cloud API key, only for LLM=1.
NEARAI_API_KEY=
# NEAR AI Cloud model for LLM=1.
NEARAI_MODEL=deepseek-ai/DeepSeek-V3.1
# Plain-language plan given to the LLM margin advisor.
PLAN=

# ---- matcher (apps/matcher CLIs: live, sim, accounts, fund, fixtures) ----
# Number of agents and tokens.
AGENTS=12
TOKENS=5
# Random seed for agents and the simulator.
SEED=1
# Milliseconds between matcher rounds; MAX_ROUNDS=0 runs forever; ROUNDS is for the simulator.
ROUND_MS=6000
MAX_ROUNDS=0
ROUNDS=30
# HTTP port and bind address for GET /api/state. PUBLIC=1 serves the read-only state API only (no agent WebSocket).
PORT=8787
HOST=
PUBLIC=0
# Number of racing matchers, their surplus shares (comma-separated), and the auction window in ms.
RACE=0
RACE_PHI=
AUCTION_MS=0
# 1 with RACE>=3: the third matcher submits with its own key (equal latency), so only the fee differs.
FEE_RACE=0
# "verifier" submits through the delegated Verifier key (the 0-block path).
SUBMIT_AS=
# 1 exits if the matcher is not on the Verifier's shard.
STRICT_COLO=0
# Top up agents automatically every N rounds (0 = off).
AUTO_FUND=0
# Simulator: backend (ledger or model), output directory, sweep over agent counts, serve the result, baseline in bps.
SIM_BACKEND=ledger
OUT_DIR=./out
SWEEP=1
SERVE=0
BASELINE_BPS=
# Account setup: NEAR per agent and per matcher; 1 skips creating board keys.
AGENT_NEAR=0.4
MATCHER_NEAR=0.5
SKIP_BOARD_KEYS=0
# Funding: USD per agent (default from config); 1 skips board storage deposits.
FUND_USD=
SKIP_BOARD=0
# Fixture rings: USD per leg and the signed deadline.
LEG_USD=0.25
FIXTURE_DEADLINE=2026-12-31T00:00:00Z

# ---- 1Click (packages/oneclick) ----
# Optional 1Click JWT; without it 1Click adds a 20 bps app fee to quotes.
ONECLICK_JWT=
# JSON map of symbol to testnet token id, e.g. {"USDC":"nep141:usdc.nomadswarm.testnet"}.
NOMAD_TESTNET_TOKENS=
# 1 allows the mainnet-only 1Click fallback to execute. Keep 0: Nomad runs on testnet.
FALLBACK_LIVE=0

# ---- scripts ----
# scripts/deploy-board.mjs: NEAR to fund the board account (max 3) and a scratch directory.
BOARD_FUNDING=3
NEAR_DEPS_DIR=/tmp/nomad-deploy
# scripts/hos-budget.ts: the leased agent name and a built hos_wallet.wasm.
HOS_AGENT=
HOS_WALLET_WASM=
# scripts/mandate-e2e.ts: 0 simulates only.
EXECUTE=1
# Screenshots and video (cdp-shot, record-site, render-demo, stitch-demo): browser, tools, sizes.
CHROME=
FFMPEG=ffmpeg
FFPROBE=ffprobe
CDP_NO_GL=
CDP_DEBUG=
VW=1440
VH=810
W=1920
H=1080
DECK_QUERY=

# ---- web UI ----
# See web/.env.example.
