{
  "name": "@nomad/oneclick",
  "version": "0.1.0",
  "private": true,
  "description": "1Click API client for Nomad: token prices, dry quotes, ring baseline, and a guarded (never-executing) fallback flow.",
  "type": "module",
  "engines": { "node": ">=20" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": { ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" } },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:live": "ONECLICK_LIVE=1 vitest run test/live.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
